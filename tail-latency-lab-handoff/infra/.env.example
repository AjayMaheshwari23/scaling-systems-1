# Keep this stable during comparable benchmark runs.
OTEL_SAMPLE_RATIO=0.05

# For maximum reproducibility, replace :latest with specific versions/digests
# after validating the stack on your machine.
POSTGRES_IMAGE=postgres:17-alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
TEMPO_IMAGE=grafana/tempo:latest
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
